# Example environment configuration for gen-qr
# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# Note: .env.local should be gitignored (recommended). Do not commit secrets.

# Optional: Absolute base URL of your deployment (useful for metadata/canonical URLs).
# Example:
# NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=

# Optional: Control maximum QR image size allowed by the API.
# Keep this in sync with UI options (e.g., 256/512/1024).
# QR_MAX_SIZE=1024
QR_MAX_SIZE=1024

# Optional: Default QR size used when client doesn't specify.
# QR_DEFAULT_SIZE=512
QR_DEFAULT_SIZE=512